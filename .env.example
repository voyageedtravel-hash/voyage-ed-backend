# ─── Voyage-Ed Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# On Railway/Render: add these in the "Variables" / "Environment" dashboard panel.

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: Atlas → Connect → Drivers → copy the connection string
# Replace <username>, <password>, and set DB name to: voyage-ed-crm
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/voyage-ed-crm?retryWrites=true&w=majority

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Your Netlify website URL (no trailing slash)
WEBSITE_URL=https://voyage-ed.netlify.app

# Your CRM deployment URL (Netlify/Vercel — where travel-crm-v9 is hosted)
CRM_URL=https://voyage-ed-crm.netlify.app

# ── Port (Railway sets this automatically — don't change) ─────────────────────
PORT=5000

# ── Users (JSON array with bcrypt password hashes) ────────────────────────────
# To generate a hash: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"
# Role options: "admin" | "staff"
#
# Example (replace hashes with real ones!):
USERS_JSON=[{"username":"vishal","passwordHash":"$2a$10$REPLACE_WITH_REAL_HASH","role":"admin"},{"username":"sahitya","passwordHash":"$2a$10$REPLACE_WITH_REAL_HASH","role":"staff"}]
